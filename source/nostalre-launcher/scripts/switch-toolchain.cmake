set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER /opt/devkitpro/devkitA64/bin/aarch64-none-elf-gcc)
set(CMAKE_CXX_COMPILER /opt/devkitpro/devkitA64/bin/aarch64-none-elf-g++)
set(CMAKE_AR /opt/devkitpro/devkitA64/bin/aarch64-none-elf-ar)
set(CMAKE_RANLIB /opt/devkitpro/devkitA64/bin/aarch64-none-elf-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH /opt/devkitpro/portlibs/switch /opt/devkitpro/devkitA64/aarch64-none-elf)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(SWITCH_FLAGS "-D__SWITCH__ -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIC -ftls-model=local-exec -ffunction-sections -fdata-sections -isystem /opt/devkitpro/libnx/include -isystem /opt/devkitpro/portlibs/switch/include")
set(CMAKE_C_FLAGS_INIT "${SWITCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${SWITCH_FLAGS}")
set(CMAKE_HAVE_LIBC_PTHREAD 1 CACHE INTERNAL "")
set(CMAKE_USE_PTHREADS_INIT 1 CACHE INTERNAL "")
set(THREADS_PREFER_PTHREAD_FLAG OFF CACHE BOOL "")
set(HAVE_TLS_EXITCODE 0 CACHE STRING "")
set(HAVE_MONOTONIC_CLOCK_EXITCODE 0 CACHE STRING "")
